# Copy to `.env` and fill in as needed. `.env` is gitignored and must never be committed.

# Optional override for the World Athletics base URL used by src/scraper.py.
# TRACKFLATION_WA_BASE_URL=https://worldathletics.org/records/toplists

# Optional polite-scraping delay, in seconds, between HTTP requests.
# TRACKFLATION_SCRAPE_DELAY=1.0
